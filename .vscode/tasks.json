{
  // Repo-matched task surface for the Delphi 7 TSLPatcher workflow.
  "version": "2.0.0",
  "windows": {
    "options": {
      "shell": {
        "executable": "cmd.exe",
        "args": ["/d", "/c"]
      }
    }
  },
  "tasks": [
    {
      "label": "TSLPatcher: Validate repo surface",
      "type": "shell",
      "command": "test -f TSLPatcher.dpr && test -f UMainForm.pas && test -f UTSLPatcher.pas && test -f UNamespaceForm.pas && echo 'Repo surface OK'",
      "windows": {
        "command": "if not exist TSLPatcher.dpr (echo Missing TSLPatcher.dpr & exit /b 1) else if not exist UMainForm.pas (echo Missing UMainForm.pas & exit /b 1) else if not exist UTSLPatcher.pas (echo Missing UTSLPatcher.pas & exit /b 1) else if not exist UNamespaceForm.pas (echo Missing UNamespaceForm.pas & exit /b 1) else echo Repo surface OK"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "detail": "Checks that the active entrypoint and core orchestration units are present."
    },
    {
      "label": "TSLPatcher: Validate default runtime data",
      "type": "shell",
      "command": "test -d tslpatchdata && test -f tslpatchdata/changes.ini && test -f tslpatchdata/info.rtf && echo 'Default runtime data OK'",
      "windows": {
        "command": "if not exist tslpatchdata (echo Missing tslpatchdata directory & exit /b 1) else if not exist tslpatchdata\\changes.ini (echo Missing tslpatchdata\\changes.ini & exit /b 1) else if not exist tslpatchdata\\info.rtf (echo Missing tslpatchdata\\info.rtf & exit /b 1) else echo Default runtime data OK"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "detail": "Checks the default runtime inputs expected by TSLPatcher.dpr and the main form flow."
    },
    {
      "label": "TSLPatcher: Validate default launch surface",
      "dependsOrder": "sequence",
      "dependsOn": [
        "TSLPatcher: Validate repo surface",
        "TSLPatcher: Validate default runtime data"
      ],
      "problemMatcher": [],
      "runOptions": {
        "reevaluateOnRerun": true
      },
      "detail": "Hidden helper task used before default launch flows.",
      "hide": true
    },
    {
      "label": "TSLPatcher: Build project (Delphi 7)",
      "type": "process",
      "command": "/usr/bin/env",
      "args": [
        "bash",
        "-lc",
        "printf 'Delphi 7 build is only supported from a Windows host.\\n'; exit 1"
      ],
      "windows": {
        "command": "${input:delphiCompiler}",
        "args": [
          "TSLPatcher.dpr"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "TSLPatcher: Validate repo surface"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": {
        "owner": "pascal",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "source": "dcc32",
        "pattern": {
          "regexp": "^(.*)\\((\\d+)\\)\\s+((?:Fatal|Error|Warning|Hint):\\s+(?:[A-Z]\\d+\\s+)?.*)$",
          "file": 1,
          "line": 2,
          "message": 3,
          "severity": "error"
        }
      },
      "presentation": {
        "reveal": "always",
        "revealProblems": "onProblem",
        "panel": "dedicated",
        "clear": true
      },
      "detail": "Compiles TSLPatcher.dpr with a Delphi 7-compatible compiler on Windows."
    },
    {
      "label": "TSLPatcher: Run built executable",
      "type": "process",
      "command": "/usr/bin/env",
      "args": [
        "bash",
        "-lc",
        "printf 'TSLPatcher.exe launch is only supported from a Windows host.\\n'; exit 1"
      ],
      "windows": {
        "command": "${workspaceFolder}\\${input:tslpExecutable}"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "TSLPatcher: Validate default launch surface"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "detail": "Launches the built executable with its default changes.ini and info.rtf behavior."
    },
    {
      "label": "TSLPatcher: Run built executable with overrides",
      "type": "process",
      "command": "/usr/bin/env",
      "args": [
        "bash",
        "-lc",
        "printf 'TSLPatcher.exe launch is only supported from a Windows host.\\n'; exit 1"
      ],
      "windows": {
        "command": "${workspaceFolder}\\${input:tslpExecutable}",
        "args": [
          "${input:overrideIni}",
          "${input:overrideInfo}"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "TSLPatcher: Validate repo surface"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "detail": "Launches the built executable with explicit .ini and .rtf overrides, matching TSLPatcher.dpr CLI handling."
    }
  ],
  "inputs": [
    {
      "id": "delphiCompiler",
      "type": "promptString",
      "description": "Path to your Delphi 7 command-line compiler executable",
      "default": "dcc32.exe"
    },
    {
      "id": "tslpExecutable",
      "type": "promptString",
      "description": "Path to the built TSLPatcher executable, relative to the workspace root on Windows",
      "default": "TSLPatcher.exe"
    },
    {
      "id": "overrideIni",
      "type": "promptString",
      "description": "INI file path to pass as argument 1 to TSLPatcher.exe",
      "default": "changes.ini"
    },
    {
      "id": "overrideInfo",
      "type": "promptString",
      "description": "RTF file path to pass as argument 2 to TSLPatcher.exe",
      "default": "info.rtf"
    }
  ]
}